<Project>
  <PropertyGroup>
    <Version>0.2.0</Version>
    <PackageVersion>0.2.0</PackageVersion>
    <Authors>Niladri Prasad Padhy</Authors>
    <Company>Nuvyntra Labs</Company>
    <Copyright>Copyright (c) Nuvyntra Labs</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nuvyntralabs.github.io/toolkits/nuvyn/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/Nuvyn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
