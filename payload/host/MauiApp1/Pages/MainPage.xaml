<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nv="http://nuvyntralabs.com/uikit"
    xmlns:local="clr-namespace:MauiApp1;assembly=MauiApp1.Core"
    x:Class="MauiApp1.MainPage"
    x:DataType="local:MainPageViewModel"
    Title="Nuvyntra">

    <VerticalStackLayout
        Padding="24"
        Spacing="24"
        VerticalOptions="Center"
        HorizontalOptions="Center">
        <Image
            Source="nuvyntra.png"
            WidthRequest="128"
            HeightRequest="128"
            HorizontalOptions="Center"
            SemanticProperties.Description="Nuvyntra" />
        <nv:NVHeading Text="{Binding Count, StringFormat='Count: {0}'}" />
        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
            <nv:NVButton Text="Decrease" Variant="Outline" Command="{Binding DecreaseCommand}" />
            <nv:NVButton Text="Increase" Variant="Filled" Command="{Binding IncreaseCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
